{
  "request": {
    "method": "POST",
    "url": "/external/json",
    "headers": {
      "Content-Type": {
        "contains": "application/json"
      }
    },
    "bodyPatterns": [
      {
        "matchesJsonPath": "$.user.id[?(@ == 'u-100')]"
      },
      {
        "matchesJsonPath": "$.user.name[?(@ == 'angrypig')]"
      }
    ]
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json"
    },
    "jsonBody": {
      "message": "json path success"
    }
  }
}